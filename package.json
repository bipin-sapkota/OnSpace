{
  "name": "onspace",
  "private": true,
  "version": "0.1.0",
  "description": "OnSpace — an open-world procedural space exploration game built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "assets": "node tools/assets/build.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "draco3dgltf": "^1.5.7",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.0"
  }
}
